# ============================================================================
# LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your values.

# Django Settings
SECRET_KEY=django-insecure-change-this-to-a-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Generate a new SECRET_KEY:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ============================================================================
# DATABASE - PostgreSQL (local)
# ============================================================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=library_db
DB_USER=library_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# ============================================================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ============================================================================
# To get a Gmail App Password:
# 1. Go to https://myaccount.google.com/ → Security → 2-Step Verification
# 2. Scroll to App passwords → generate one for "Mail"
# 3. Paste the 16-character password below

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Smart Library <your-email@gmail.com>
SERVER_EMAIL=your-email@gmail.com

# Site Configuration
SITE_NAME=Smart Library Management System
SITE_URL=http://127.0.0.1:8080

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================

# Stripe (International Payments)
# Get test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Chapa (Ethiopian Payments)
# Get test keys from: https://dashboard.chapa.co/
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key_here
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here

# ============================================================================
# OPTIONAL: REDIS & CELERY
# ============================================================================
# By default Celery runs in eager (synchronous) mode — no Redis needed.
# To use a real Redis worker locally, install Redis and set REDIS_URL.

# REDIS_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=False
